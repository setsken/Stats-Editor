# Server Configuration
PORT=3000
NODE_ENV=production

# Database (Railway PostgreSQL) - Railway provides this automatically via Variable Reference
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# NOWPayments API
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENTS_SANDBOX=false

# Stripe (for later)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# App URL (Railway provides this as RAILWAY_PUBLIC_DOMAIN)
# APP_URL will be set automatically or use: https://your-app.railway.app

# Trial Settings
TRIAL_DAYS=7
