{
  "manifest_version": 3,
  "name": "Of Stats Editor (Mobile)",
  "version": "1.3.0",
  "description": "Professional statistics editor for OnlyFans creators. Mobile build for Orion browser (iOS/iPadOS).",
  "key": "",
  "externally_connectable": {
    "ids": [
      "ameodildcepananbbacdiiindpbgmjpj"
    ]
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://onlyfans.com/*",
    "https://stats-editor-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["chart.min.js", "chart-drawer.js", "page-interceptor.js"],
      "matches": ["https://onlyfans.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://onlyfans.com/*"],
      "js": ["inject-early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://onlyfans.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
